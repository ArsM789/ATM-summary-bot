# Скопируйте этот файл в .env и заполните BOT_TOKEN:  cp .env.example .env

# --- Обязательное ---
# Токен от @BotFather
BOT_TOKEN=

# --- Необязательное (значения по умолчанию показаны) ---
BOT_NAME=ATM Morning Assistant
DEFAULT_CITY=Казань
DEFAULT_LATITUDE=55.7887
DEFAULT_LONGITUDE=49.1221
DEFAULT_TIMEZONE=Europe/Moscow
# Время первой автоматической сводки для нового пользователя (ЧЧ:ММ)
DEFAULT_SEND_TIME=07:00
# Уроки по дням, Пн..Вс (0 = выходной)
DEFAULT_LESSONS=7,6,6,7,7,0,0

DATABASE_PATH=data/atm_morning.db
WEATHER_CACHE_TTL=600
WEATHER_TIMEOUT=10
WEATHER_RETRIES=2
LOG_LEVEL=INFO

# Premium Custom Emoji (необязательно). JSON: ключ -> числовой id эмодзи.
# Работает только если у владельца бота есть Telegram Premium. Пример формата:
# CUSTOM_EMOJI_IDS={"sun":"1234567890123456789"}
# Не заполняйте выдуманными id — без настоящих id бот использует обычные эмодзи.
CUSTOM_EMOJI_IDS=
